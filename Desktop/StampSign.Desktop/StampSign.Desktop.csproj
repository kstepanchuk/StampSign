<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <ProjectReference Include="..\StampSign.Core\StampSign.Core.csproj" />
    <ProjectReference Include="..\StampSign.Pdf\StampSign.Pdf.csproj" />
    <Content Include="tools/stamp-pdf*" CopyToOutputDirectory="PreserveNewest" Link="tools/%(Filename)%(Extension)" />
    <Content Include="Signing/*.html" CopyToOutputDirectory="PreserveNewest" Link="Signing/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
